# NurtureOS — environment
# Copy to .env.local and fill in. Never commit filled values.

# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server + worker only, never exposed to the client
SUPABASE_STORAGE_BUCKET=reports     # private bucket, signed URLs only

# ---------- Queue ----------
DATABASE_URL=                        # pg-boss connection, same Postgres instance
WORKER_CONCURRENCY=6

# ---------- Azure AI Foundry ----------
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=               # or use managed identity in production
AZURE_FOUNDRY_API_VERSION=

# Model deployments — one per tier
FOUNDRY_DEPLOYMENT_VISION=           # Extract: vision + high max output tokens
FOUNDRY_DEPLOYMENT_REASONING=        # Normalise, Analyse, Plan synthesis
FOUNDRY_DEPLOYMENT_SMALL=            # Corroborate, Check-in

# Prompt assets — PINNED versions. Never 'latest'.
# Bumping any of these is a pull request, which triggers the eval run in CI.
FOUNDRY_PROMPT_EXTRACT=extract-report-page:1
FOUNDRY_PROMPT_NORMALISE=normalise-observations:1
FOUNDRY_PROMPT_ANALYSE=analyse-record:1
FOUNDRY_PROMPT_CORROBORATE=corroborate-claim:1
FOUNDRY_PROMPT_PLAN=synthesise-plan:1
FOUNDRY_PROMPT_CHECKIN=interpret-checkin:1

# ---------- Azure Document Intelligence ----------
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
AZURE_DOCINT_MODEL=prebuilt-layout

# ---------- Email ----------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ---------- Check-in tokens ----------
CHECKIN_TOKEN_SECRET=                # 32+ random bytes, HMAC key
CHECKIN_TOKEN_TTL_DAYS=21

# ---------- Gates ----------
SUFFICIENCY_MIN_OBSERVATIONS=25
SUFFICIENCY_MIN_SOLID_RATIO=0.5
SUFFICIENCY_MIN_NARRATIVE_CHARS=200
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ---------- Ops ----------
REVIEW_REQUIRED=true                 # 100% human review at MVP. Do not disable before Launch.
