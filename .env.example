# NurtureOS — environment
# Copy to .env.local and fill in. Never commit filled values.

# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server + worker only, never exposed to the client

# ---------- Queue ----------
# pg-boss talks to Postgres directly (not PostgREST), so this is a raw
# connection string, separate from the Supabase keys above.
#
# Use the SESSION pooler (port 5432), not Transaction (6543): Supavisor's
# transaction mode disables prepared statements, which pg-boss relies on.
# Avoid the direct db.<ref>.supabase.co host — it resolves to IPv6 only and is
# unreachable on many networks.
#
# Percent-encode special characters in the password ($ -> %24). Next.js runs
# .env files through dotenv-expand, which treats a bare $ as interpolation and
# silently mangles the password — the worker parses .env raw and connects fine
# while the web app fails with "password authentication failed".
#
# The session pooler caps the project at 15 client connections, shared by the
# worker, the web app and any script, and a session-mode connection is held for
# the life of the client — a killed process keeps its slot until the socket
# times out. Pool sizes are set small and deliberately in code (worker 3, web
# sender 2, scripts 1); raising them tends to surface as EMAXCONNSESSION on some
# unrelated request rather than where the connections were actually taken.
DATABASE_URL=                        # postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
WORKER_CONCURRENCY=6

# ---------- LLM tier routing ----------
# Each tier can be independently pointed at any supported provider.
# Supported values: anthropic | gemini | openai | grok | kimi
LLM_VISION_PROVIDER=gemini           # fallback for Extract
LLM_REASONING_PROVIDER=gemini        # fallback for Normalise, Analyse, Plan
LLM_SMALL_PROVIDER=openai            # fallback for Corroborate, Check-in

# Optional tier-wide model overrides. Defaults are per-provider in
# src/server/llm/client.ts. A blank value falls through to the default.
LLM_MODEL_VISION=
LLM_MODEL_REASONING=
LLM_MODEL_SMALL=

# Per-stage overrides take precedence over the tier settings above, so each of
# the six prompts can run on its own model. Leave blank to inherit the tier.
LLM_EXTRACT_PROVIDER=
LLM_MODEL_EXTRACT=
LLM_NORMALISE_PROVIDER=
LLM_MODEL_NORMALISE=
LLM_ANALYSE_PROVIDER=
LLM_MODEL_ANALYSE=
LLM_PLAN_PROVIDER=
LLM_MODEL_PLAN=
LLM_CORROBORATE_PROVIDER=
LLM_MODEL_CORROBORATE=
LLM_CHECKIN_PROVIDER=
LLM_MODEL_CHECKIN=

# Gemini-only thinking level (minimal|low|medium|high), per stage.
# gemini-3.7-flash rejects "minimal"; only Flash-Lite supports that floor.
LLM_THINKING_PLAN=

# Prompt versions — PINNED. Incrementing any value is a pull request that
# triggers the eval run in CI.
PROMPT_VERSION_EXTRACT=2
PROMPT_VERSION_NORMALISE=1
PROMPT_VERSION_ANALYSE=1
PROMPT_VERSION_CORROBORATE=1
PROMPT_VERSION_PLAN=1
PROMPT_VERSION_CHECKIN=1

# ---------- Model providers ----------
# Only the providers actually referenced above need a key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # optional — blank for https://api.openai.com/v1

# xAI / Grok and Moonshot / Kimi are OpenAI-compatible.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---------- Email ----------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ---------- Check-in tokens ----------
CHECKIN_TOKEN_SECRET=                # 32+ random bytes, HMAC key
CHECKIN_TOKEN_TTL_DAYS=21

# ---------- Gates ----------
SUFFICIENCY_MIN_OBSERVATIONS=25
SUFFICIENCY_MIN_SOLID_RATIO=0.5
SUFFICIENCY_MIN_NARRATIVE_CHARS=200
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ---------- Ops ----------
REVIEW_REQUIRED=true                 # 100% human review at MVP. Do not disable before Launch.
