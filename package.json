{
  "name": "nurtureos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n next,worker -c blue,magenta \"npm:dev:next\" \"npm:worker\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:schema": "node scripts/verify-schema.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "smoke:queue": "node scripts/smoke-queue.mjs",
    "worker": "tsx src/server/queue/worker.ts",
    "worker:stop": "node scripts/stop-workers.mjs",
    "enqueue": "node scripts/enqueue.mjs",
    "make:ops": "node scripts/make-ops-user.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:routing": "tsx evals/scripts/run_evals.ts",
    "eval:grounding": "tsx evals/scripts/run_grounding_eval.ts",
    "eval:venue": "tsx evals/scripts/run_local_venue_eval.ts",
    "eval:nearby": "tsx evals/scripts/run_nearby_resources_eval.ts",
    "eval:planning-tools": "tsx evals/scripts/run_planning_tool_eval.ts",
    "eval:local-mix": "tsx evals/scripts/run_local_mix_eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "resend": "^6.34.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
